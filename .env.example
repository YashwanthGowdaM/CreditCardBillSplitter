# =============================================================================
# CardSplit - environment settings
# Copy this file to ".env" and change the values:   cp .env.example .env
# docker compose reads ".env" automatically. Never commit your real .env file.
# =============================================================================

# ---- Master admin password (unlocks Add / Edit / Delete / Import in the app) ----
ADMIN_PASSWORD=Yash@123

# ---- Database credentials (used by BOTH the database and the backend) ----
DB_NAME=cardsplit
DB_USER=cardsplit
DB_PASSWORD=change-me-db-password
# NOTE: the database user/password are fixed the FIRST time the database starts.
#       Changing them later requires resetting the volume (see setup guide, "Reset everything").

# ---- Ports on YOUR computer (change if a port is already in use) ----
FRONTEND_PORT=3000
BACKEND_PORT=5000

# ---- Only needed if you call the API from a different website/domain ----
CORS_ORIGIN=*
